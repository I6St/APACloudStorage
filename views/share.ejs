<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>分享的文件</title>
    <style>
        body {
            text-align: center;
        }
        button, input {
            margin: 10px;
            padding: 10px 20px;
        }
        .file-list {
            text-align: left;
            display: inline-block;
            width: 100%;
            max-width: 600px;
        }
        .file-item {
            margin: 8px 0;
            padding: 8px;
            border-bottom: 1px solid #eee;
        }
        .error {
            color: red;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>分享的文件</h1>
        <% if (needCode) { %>
            <p>此分享链接已设置提取码</p>
            <% if (error) { %>
                <p class="error">提取码错误，请重试</p>
            <% } %>
            <form method="GET" action="/share/<%= token %>">
                <input type="text" name="code" placeholder="请输入提取码" required>
                <button type="submit">验证</button>
            </form>
        <% } else if (isFolder) { %>
            <h3>文件夹: <%= share.itemPath %></h3>
            <p>共 <%= files.length %> 个文件</p>
            <div class="file-list">
                <% files.forEach(function(f) { 
                    const dlPath = encodeBase64(share.username + '/' + f.path);
                %>
                    <div class="file-item">📄 <%= f.name %> <button onclick="window.open('/download/<%= dlPath %>')">下载</button></div>
                <% }) %>
            </div>
        <% } else { %>
            <h3><%= fileName %></h3>
            <button onclick="window.open('/download/<%= encodeBase64(share.username + '/' + share.itemPath) %>')">下载文件</button>
        <% } %>
    </div>
    <hr><footer>&copy; APACloudStorage 2026. 保留所有权利。</footer>
</body>
</html>
